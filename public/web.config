<?xml version="1.0" encoding="UTF-8"?>
<!--
  تنظیمات IIS برای نرم‌افزار حسابداری (PHP + FastCGI + URL Rewrite)

  پیش‌نیازها:
    1. نقش‌های IIS: Static Content، Default Document، Request Filtering، HTTP Errors،
       Static/Dynamic Compression و ماژول URL Rewrite نصب باشد.
    2. PHP نسخه 8.1 یا جدیدتر (نسخه Non Thread Safe) در مسیر C:\php نصب باشد.
    3. ریشه سایت (Site Root) در IIS روی پوشه public همین پروژه تنظیم شود.
    4. اگر PHP در سطح سرور (Handler Mappings) از قبل ثبت شده، بخش <handlers> را حذف کنید
       تا «Handler تکراری» و خطای 500.19 یا 403 ایجاد نشود.
-->
<configuration>
  <system.webServer>

    <!-- فایل‌های پیش‌فرض: وقتی آدرس پوشه وارد شود، index.php باز می‌شود -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- فهرست‌گیری پوشه‌ها ممنوع است -->
    <directoryBrowse enabled="false" />

    <!-- اجرای PHP با FastCGI -->
    <handlers>
      <remove name="PHP_via_FastCGI" />
      <add name="PHP_via_FastCGI" path="*.php" verb="GET,HEAD,POST,PUT,DELETE,OPTIONS"
           modules="FastCgiModule" scriptProcessor="C:\php\php-cgi.exe"
           resourceType="Either" requireAccess="Script" />
    </handlers>

    <!-- بازنویسی آدرس‌ها (URL Rewrite) -->
    <rewrite>
      <rules>
        <!-- پوشه data هیچ‌وقت از وب قابل دسترسی نیست -->
        <rule name="BlockData" stopProcessing="true">
          <match url="^data/.*" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden"
                  statusDescription="Forbidden" />
        </rule>

        <!-- هر آدرسی که فایل یا پوشه‌ی واقعی نباشد، به index.php (Front Controller) فرستاده می‌شود -->
        <rule name="FrontController" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>

    <!--
      خطاهای سرور: در محیط عملیاتی صفحه‌ی جزئیات فقط برای درخواست‌های محلی نمایش داده می‌شود.
      existingResponse="PassThrough": صفحه‌ی خطای خود برنامه (فارسی) دست‌نخورده نمایش داده شود.
    -->
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

    <!-- فیلترینگ درخواست‌ها و امنیت -->
    <security>
      <requestFiltering>
        <!-- حداکثر حجم بدنه‌ی درخواست: 100 مگابایت -->
        <requestLimits maxAllowedContentLength="104857600" />

        <!-- پوشه‌های داخلی برنامه از وب قابل دسترسی نیستند -->
        <hiddenSegments>
          <add segment="includes" />
          <add segment="data" />
          <add segment="tools" />
          <add segment="database" />
          <add segment="app" />
          <add segment="config" />
          <add segment="storage" />
          <add segment="db" />
          <add segment="tests" />
        </hiddenSegments>

        <!-- پسوندهای حساس (پایگاه داده، گزارش‌ها و فایل‌های قفل) ممنوع است -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".sqlite" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- نوع فایل‌ها (MIME) برای فونت، تصویر و منیفست PWA -->
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- فایل‌های ایستا یک هفته در مرورگر کش شوند -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- فشرده‌سازی پاسخ‌ها (gzip) برای سرعت بیشتر -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- هدرهای امنیتی -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!-- Service Worker همیشه تازه بررسی شود تا نسخه‌ی جدید برنامه سریع اعمال شود -->
  <location path="sw.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- منیفست PWA کوتاه‌مدت کش شود -->
  <location path="manifest.webmanifest">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:05:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
