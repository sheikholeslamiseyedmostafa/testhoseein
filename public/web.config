<?xml version="1.0" encoding="utf-8"?>
<!--
  تنظیمات IIS برای نرم‌افزار حسابداری (PHP + FastCGI)

  پیش‌نیاز: در IIS، PHP (نسخه 8.1 یا جدیدتر، نسخه Non Thread Safe) نصب شده باشد و
  مسیر php-cgi.exe در بخش scriptProcessor زیر درست باشد.
  اگر Handler مربوط به PHP در سطح سرور از قبل تعریف شده، بخش <handlers> را حذف کنید تا تداخل ایجاد نشود.

  ریشه سایت در IIS باید روی پوشه public همین پروژه تنظیم شود.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <handlers>
      <remove name="PHP-FastCGI-Accounting" />
      <add name="PHP-FastCGI-Accounting" path="*.php" verb="GET,HEAD,POST" modules="FastCgiModule"
           scriptProcessor="C:\PHP\php-cgi.exe" resourceType="Either" requireAccess="Script" />
    </handlers>

    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Service Worker و منیفست همیشه تازه بررسی شوند -->
    <location path="sw.js">
      <system.webServer>
        <staticContent>
          <clientCache cacheControlMode="DisableCache" />
        </staticContent>
      </system.webServer>
    </location>
    <location path="manifest.webmanifest">
      <system.webServer>
        <staticContent>
          <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:05:00" />
        </staticContent>
      </system.webServer>
    </location>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
        <hiddenSegments>
          <add segment="storage" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
